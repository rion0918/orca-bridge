# Orca Bridge の設定テンプレート。.env としてコピーして使う。
# KEY=VALUE形式。引用符・export・シェル展開は使用しない。
# コピーする場合、下記2値を異なるランダム値に置換しchmod 600 .env。
# 推奨: .envを作らずserve.pyを起動してトークンを自動生成。
BRIDGE_TOKEN=REPLACE_WITH_RANDOM_WRITE_TOKEN
BRIDGE_READ_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_READ_TOKEN
# Set this to your own ngrok Dev Domain before starting an ngrok tunnel.
# BRIDGE_NGROK_URL=https://your-dev-domain.ngrok-free.dev
# 1で全許可プロジェクトの開発を自動実行（sandbox以外も対象）
BRIDGE_AUTORUN_SANDBOX=0
# Ordered local agent choices. Default: codex. Claude is opt-in and always requires local approval.
# BRIDGE_AGENTS=codex,claude
# 任意。未設定ならPATHのorca（開発ルート設定時はorca-dev）
# ORCA_CLI_COMMAND=/path/to/orca
# 開発用途のみ。設定すると上記未指定時はorca-devを使う
# ORCA_DEV_REPO_ROOT=/path/to/orca-development-root
# 以下2変数はOrca呼び出しから除去されるため通常設定不要
# ORCA_ENVIRONMENT=local
# ORCA_PAIRING_CODE=UNUSED_PLACEHOLDER
# 以下はOS環境を継承。通常は.envで設定しない
# HOME=/path/to/user-home
# PATH=/path/to/cli/bin:/usr/bin:/bin:/usr/sbin:/sbin
# USER=YOUR_LOCAL_USER
# LANG=ja_JP.UTF-8
# TMPDIR=/path/to/private-temporary-directory
