  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewProject": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "NewProject"
      },
      "Task": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Prompt"
          },
          "project": {
            "type": "string",
            "title": "Project",
            "default": "sandbox"
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 10.0,
            "title": "Timeout Seconds",
            "default": 300
          },
          "operation": {
            "type": "string",
            "enum": [
              "development",
              "deployment",
              "spending"
            ],
            "title": "Operation",
            "default": "development"
          },
          "execution_profile": {
            "type": "string",
            "enum": [
              "sol_low",
              "sol_high",
              "sol_max",
              "hydrogen_high",
              "argon_high"
            ],
            "title": "Execution Profile",
            "default": "sol_low"
          },
          "execution_reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Execution Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "Task"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
