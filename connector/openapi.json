  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewProject": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "NewProject"
      },
      "Task": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Prompt"
          },
          "project": {
            "type": "string",
            "title": "Project",
            "default": "sandbox"
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 10.0,
            "title": "Timeout Seconds",
            "default": 300
          },
          "operation": {
            "type": "string",
            "enum": [
              "development",
              "deployment",
              "spending"
            ],
            "title": "Operation",
            "default": "development"
          },
          "execution_profile": {
            "type": "string",
            "enum": [
              "sol_low",
              "sol_high",
              "sol_max",
              "hydrogen_high",
              "argon_high"
            ],
            "title": "Execution Profile",
            "default": "sol_low"
          },
          "execution_reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Execution Reason",
            "default": ""
          },
          "continues_task": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Continues Task"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "Task"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "CommitRequest": {
        "properties": {
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Paths"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paths",
          "message"
        ],
        "title": "CommitRequest"
      },
      "EnvironmentExampleRequest": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "EnvironmentExampleRequest"
      },
      "CleanupRequest": {
        "properties": {
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Paths"
          },
          "recursive": {
            "type": "boolean",
            "title": "Recursive",
            "default": false
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          },
          "empty_tree": {
            "type": "boolean",
            "title": "Empty Tree",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paths"
        ],
        "title": "CleanupRequest"
      },
      "EnvironmentExampleResponse": {
        "properties": {
          "project": {
            "type": "string",
            "title": "Project"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "project",
          "content"
        ],
        "title": "EnvironmentExampleResponse"
      },
      "RenameExampleResponse": {
        "properties": {
          "project": {
            "type": "string",
            "title": "Project"
          },
          "renamed_to": {
            "type": "string",
            "const": ".env.example",
            "title": "Renamed To"
          }
        },
        "type": "object",
        "required": [
          "project",
          "renamed_to"
        ],
        "title": "RenameExampleResponse"
      },
      "CommitResponse": {
        "properties": {
          "project": {
            "type": "string",
            "title": "Project"
          },
          "commit": {
            "type": "string",
            "title": "Commit"
          },
          "files": {
            "type": "integer",
            "title": "Files"
          },
          "published": {
            "type": "boolean",
            "const": false,
            "title": "Published"
